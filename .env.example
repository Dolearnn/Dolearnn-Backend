PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://2025@localhost:5432/dolearn?schema=public"
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
RESET_PASSWORD_EXPIRES_IN_MINUTES="30"
ENABLE_API_DOCS="false"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
EMAIL_PROVIDER="smtp"
EMAIL_FROM_EMAIL="hello@dolearnn.com"
EMAIL_FROM_NAME="DoLearnn"
RESEND_API_KEY="re_xxxxxxxxx"
SENDGRID_API_KEY="SG.xxxxxxxxx"
# Used when EMAIL_PROVIDER="smtp" (nodemailer). For Gmail: host smtp.gmail.com,
# port 465, secure true, and an App Password (not your normal password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# Optional: used by `npm run smoke` to verify the full backend flow.
SMOKE_API_URL="http://localhost:4000/api"
SMOKE_ADMIN_EMAIL="admin@example.com"
SMOKE_ADMIN_PASSWORD="replace-with-admin-password"

# Optional: switches on "Explain with AI" in the quiz review. Leave empty to keep AI off.
ANTHROPIC_API_KEY=""
# Optional: which Claude model writes explanations (default claude-opus-5).
AI_MODEL="claude-opus-5"

# What a learner pays per tutoring session, in naira. Tutors default to 50% of it.
TUTORING_SESSION_PRICE="10000"
