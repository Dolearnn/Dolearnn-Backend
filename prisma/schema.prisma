generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  STUDENT
  TEACHER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  BOTH
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
  TERMINATED
}

enum GradeLevel {
  PRIMARY
  JSS
  SSS
  COLLEGE_YEAR_1
  COLLEGE_YEAR_2
  COLLEGE_YEAR_3
  COLLEGE_YEAR_4
  OTHER
}

enum LearningGoal {
  EXAM_PREP
  CATCH_UP_WITH_SCHOOL
  LEARN_A_NEW_SKILL
  GENERAL_IMPROVEMENT
}

enum CurrentLevel {
  STRUGGLING
  AVERAGE
  ABOVE_AVERAGE
}

enum GenderPreference {
  NO_PREFERENCE
  MALE
  FEMALE
}

enum TeacherGender {
  MALE
  FEMALE
}

enum TimeBlock {
  MORNING
  AFTERNOON
  EVENING
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum SessionStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CancellationRequester {
  FAMILY
  TEACHER
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Performance {
  EXCELLENT
  GOOD
  NEEDS_WORK
}

enum PaymentPlan {
  SINGLE_SESSION
  STARTER_BUNDLE
}

enum PaymentGateway {
  OFFLINE
  STRIPE
  FLUTTERWAVE
}

enum PayoutStatus {
  PENDING
  PAID
}

enum BookingRequestStatus {
  PENDING
  SCHEDULED
  CANCELLED
}

enum LessonPackageStatus {
  ACTIVE
  EXHAUSTED
  CANCELLED
}

enum LeadSource {
  WAITLIST
  NEWSLETTER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  PRACTICE
  MOCK
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AuditAction {
  STUDENT_CREATED
  PAYMENT_RECORDED
  PAYOUT_MARKED_PAID
  MEETING_LINK_UPDATED
  CANCELLATION_APPROVED
  CANCELLATION_REJECTED
  TEACHER_RATE_UPDATED
  TEACHER_TERMINATED
  FAMILY_ATTENDANCE_CONFIRMED
  TEACHER_ATTENDANCE_CONFIRMED
}

enum AuditEntityType {
  STUDENT
  PAYMENT
  PAYOUT
  SESSION
  CANCELLATION
  TEACHER
  ATTENDANCE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  authProvider AuthProvider  @default(EMAIL)
  name         String
  role         Role
  status       AccountStatus @default(ACTIVE)
  tokenVersion Int           @default(0)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  parentProfile  ParentProfile?
  teacherProfile TeacherProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]
  quizAttempts   QuizAttempt[]
  topicStats     UserTopicStat[]
  arenaChallenges ArenaChallenge[]
  arenaEntries    ArenaEntry[]
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  whatsapp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]
  payments Payment[]
  lessonPackages StudentLessonPackage[]
  bookingRequests SessionBookingRequest[]
}

model TeacherProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  firstName         String
  lastName          String
  timezone          String        @default("Africa/Lagos")
  phoneCountry      String?
  phoneNumber       String?
  gender            TeacherGender?
  bio               String?
  subjects          String[]
  qualifications    String[]
  bankName          String?
  accountName       String?
  accountNumber     String?
  hourlyRate        Decimal       @default(0) @db.Decimal(10, 2)
  rating            Decimal       @default(0) @db.Decimal(3, 2)
  totalSessions     Int           @default(0)
  status            AccountStatus @default(ACTIVE)
  terminationReason String?
  terminatedAt      DateTime?
  joinedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStudents Student[]         @relation("AssignedTeacher")
  subjectAssignments StudentSubjectAssignment[]
  sessions         Session[]
  proposals        SessionProposal[]
  notes            SessionNote[]
  payouts          TeacherPayout[]
  notifications    Notification[]    @relation("TeacherNotifications")
  auditLogs        AuditLog[]        @relation("TeacherAuditLogs")
}

model Student {
  id                 String        @id @default(cuid())
  parentId           String
  assignedTeacherId  String?
  fullName           String
  age                Int
  grade              GradeLevel
  gradeOther         String?
  school             String?
  status             AccountStatus @default(ACTIVE)
  deactivationReason String?
  deactivatedAt      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  parent          ParentProfile     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  assignedTeacher TeacherProfile?   @relation("AssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  subjectAssignments StudentSubjectAssignment[]
  intake          Intake?
  goals           Goal[]
  sessions        Session[]
  lessonPackages  StudentLessonPackage[]
  proposals       SessionProposal[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  bookingRequests SessionBookingRequest[]
  quizAttempts    QuizAttempt[]
  arenaEntries    ArenaEntry[]

  @@index([parentId])
  @@index([assignedTeacherId])
}

model StudentSubjectAssignment {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  subject   String
  meetLink  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject])
  @@index([teacherId])
}

model SessionBookingRequest {
  id                String               @id @default(cuid())
  parentId          String
  studentId         String
  subject           String
  day               DayOfWeek
  timeBlock         TimeBlock
  timezone          String               @default("UTC")
  startTime         String
  startDate         DateTime
  sessionsRequested Int
  status            BookingRequestStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  scheduledAt       DateTime?

  parent  ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([studentId])
  @@index([status])
}

model StudentLessonPackage {
  id             String              @id @default(cuid())
  parentId       String
  studentId      String
  subject        String
  hoursPurchased Int
  hoursScheduled Int                 @default(0)
  hoursCompleted Int                 @default(0)
  amountPaid     Decimal             @db.Decimal(10, 2)
  gateway        PaymentGateway
  status         LessonPackageStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  parent   ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([parentId])
  @@index([studentId])
}

model Intake {
  id                String           @id @default(cuid())
  studentId         String           @unique
  subject           String
  subjects          String[]
  subjectOther      String?
  learningGoal      LearningGoal
  currentLevel      CurrentLevel
  specificTopics    String?
  teacherGenderPref GenderPreference
  specialNotes      String?
  timezone          String           @default("UTC")
  sessionsPerWeek   String
  budget            String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  student  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule IntakeSchedule[]
}

model IntakeSchedule {
  id       String    @id @default(cuid())
  intakeId String
  day      DayOfWeek
  time     TimeBlock

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@unique([intakeId, day])
}

model Goal {
  id         String    @id @default(cuid())
  studentId  String
  title      String
  targetDate DateTime?
  progress   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model SessionProposal {
  id           String         @id @default(cuid())
  studentId    String
  teacherId    String
  subject      String
  startsAt     DateTime
  durationMins Int
  timeBlock    TimeBlock
  note         String?
  status       ProposalStatus @default(PENDING)
  declineReason String?
  preferredAlternativeDay DayOfWeek?
  preferredAlternativeTime TimeBlock?
  preferredAlternativeExactTime String?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  session Session?

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

model Session {
  id           String        @id @default(cuid())
  studentId    String
  teacherId    String
  lessonPackageId String?
  proposalId   String?       @unique
  subject      String
  startsAt     DateTime
  durationMins Int
  meetLink     String?
  status       SessionStatus @default(UPCOMING)
  amount       Decimal       @default(0) @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lessonPackage StudentLessonPackage? @relation(fields: [lessonPackageId], references: [id], onDelete: SetNull)
  proposal     SessionProposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  attendance   Attendance?
  note         SessionNote?
  cancellations CancellationRequest[]

  @@index([studentId, startsAt])
  @@index([teacherId, startsAt])
  @@index([lessonPackageId])
  @@index([status, startsAt])
}

model Attendance {
  id                String    @id @default(cuid())
  sessionId         String    @unique
  teacherConfirmedAt DateTime?
  familyConfirmedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CancellationRequest {
  id          String                @id @default(cuid())
  sessionId   String
  requestedBy CancellationRequester
  reason      String
  status      CancellationStatus    @default(PENDING)
  requestedAt DateTime              @default(now())
  resolvedAt  DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
}

model SessionNote {
  id          String      @id @default(cuid())
  sessionId   String      @unique
  teacherId   String
  covered     String
  performance Performance
  rating      Int
  focusNext   String
  concerns    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  session Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model Payment {
  id               String         @id @default(cuid())
  parentId         String
  plan             PaymentPlan
  amount           Decimal        @db.Decimal(10, 2)
  gateway          PaymentGateway
  sessionsIncluded Int
  sessionsUsed     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  parent ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
}

model TeacherPayout {
  id        String       @id @default(cuid())
  teacherId String
  month     String
  amount    Decimal      @db.Decimal(10, 2)
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, month])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  title     String
  body      String
  read      Boolean  @default(false)
  studentId String?
  teacherId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher TeacherProfile? @relation("TeacherNotifications", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

model Lead {
  id        String     @id @default(cuid())
  source    LeadSource
  status    LeadStatus @default(NEW)
  fullName  String?
  email     String
  phone     String?
  userType  String?
  submissionCount Int  @default(1)
  lastSubmittedAt DateTime @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([source, email])
  @@index([source, status, createdAt])
  @@index([status, createdAt])
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Quizzes
//
// Read-heavy question bank + write-light attempts: one insert when an attempt
// starts and one update when it is submitted. Answers and the per-topic
// breakdown live in JSON on the attempt row, so a quiz costs two writes no
// matter how many questions it has.
// ---------------------------------------------------------------------------

model Exam {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  attempts  QuizAttempt[]
  arenaChallenges ArenaChallenge[]
}

model Subject {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics    Topic[]
  questions Question[]
  attempts  QuizAttempt[]
  arenaChallenges ArenaChallenge[]
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  slug      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]
  stats     UserTopicStat[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Question {
  id              String             @id @default(cuid())
  // Lets an import be re-run without creating duplicates.
  sourceKey       String?            @unique
  examId          String?
  subjectId       String
  topicId         String
  year            Int?
  text            String
  imageUrl        String?
  // [{ "id": "A", "text": "..." }, ...]
  options         Json
  correctOptionId String
  explanation     String?
  difficulty      QuestionDifficulty @default(MEDIUM)
  status          QuestionStatus     @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  exam    Exam?   @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Restrict)
  aiExplanation QuestionExplanation?

  @@index([subjectId, examId, status])
  @@index([topicId])
  @@index([status, createdAt])
}

// An AI-written summary of one submitted quiz (strengths, weak topics, next step),
// generated at most once per attempt. Only AI text is stored; the rules-based
// fallback is cheap to rebuild and is never saved.
model AttemptDiagnosis {
  attemptId String   @id
  body      String
  model     String
  createdAt DateTime @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

// An AI-written worked explanation, generated once per question and then shared
// by every learner, so AI cost grows with the size of the question bank rather
// than with the number of users.
model QuestionExplanation {
  questionId String   @id
  body       String
  model      String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String            @id @default(cuid())
  userId         String
  // Set when a parent takes the quiz on behalf of one of their children.
  studentId      String?
  examId         String?
  subjectId      String
  mode           QuizMode
  status         QuizAttemptStatus @default(IN_PROGRESS)
  // Ordered snapshot of the questions served, so grading never depends on the
  // question bank staying the same.
  questionIds    String[]
  totalQuestions Int
  timeLimitSecs  Int?
  startedAt      DateTime          @default(now())
  expiresAt      DateTime?
  submittedAt    DateTime?
  correctCount   Int?
  scorePercent   Int?
  timedOut       Boolean           @default(false)
  // { "<questionId>": "<optionId>" }
  answers        Json?
  // [{ "topicId", "name", "attempted", "correct" }]
  topicBreakdown Json?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  arenaEntry ArenaEntry?
  diagnosis  AttemptDiagnosis?

  @@index([userId, startedAt])
  @@index([userId, subjectId, startedAt])
  @@index([userId, status])
  @@index([studentId, startedAt])
}

// Running per-topic totals for a learner, updated once per submitted attempt.
// `learnerId` is the Student id when a parent quizzes for a child, otherwise the
// User id (both are cuids, so they cannot collide). `userId` is always the
// account that owns the data, and cascades on account deletion.
model UserTopicStat {
  learnerId     String
  topicId       String
  userId        String
  attempted     Int      @default(0)
  correct       Int      @default(0)
  lastAttemptAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([learnerId, topicId])
  @@index([userId])
  @@index([topicId])
}

// ---------------------------------------------------------------------------
// Arena (async 1v1 battles)
//
// A challenge fixes a set of questions and is shared by a short code. Each of the
// two players plays it as an ordinary QuizAttempt, so grading, topic stats and
// progress all work unchanged. A battle costs three writes to start, three more
// when the second player joins, and nothing extra when each player submits.
// ---------------------------------------------------------------------------

model ArenaChallenge {
  id              String   @id @default(cuid())
  // Short, unambiguous code that players share to join.
  code            String   @unique
  createdByUserId String
  subjectId       String
  examId          String?
  // Ordered snapshot of the questions, identical for both players.
  questionIds     String[]
  totalQuestions  Int
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  createdBy User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  exam      Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  entries   ArenaEntry[]

  @@index([createdByUserId, createdAt])
}

model ArenaEntry {
  id          String   @id @default(cuid())
  challengeId String
  // 1 = the player who created the battle, 2 = the player who joined.
  slot        Int
  userId      String
  // Set when a parent plays on behalf of one of their children.
  studentId   String?
  // First name only, so other players never see a child's full name.
  playerName  String
  attemptId   String   @unique
  joinedAt    DateTime @default(now())

  challenge ArenaChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  attempt   QuizAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Two slots per battle; also stops two people taking the second seat at once.
  @@unique([challengeId, slot])
  @@index([userId, joinedAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String
  actorRole   Role
  action      AuditAction
  entityType  AuditEntityType
  entityId    String
  summary     String
  metadata    Json?
  studentId   String?
  teacherId   String?
  createdAt   DateTime        @default(now())

  actor   User            @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  student Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher TeacherProfile? @relation("TeacherAuditLogs", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
}
